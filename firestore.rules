rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Public profile fields only. Admin and premium flags are never client-writable.
    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt']);
      allow delete: if owns(uid);
    }

    // Per-user app state. The user cannot write another user's document.
    match /userData/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['uid', 'data', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.data is map
        && request.resource.data.data.size() <= 100;
      allow delete: if owns(uid);
    }

    // Payment requests may be submitted by their owner, but never approved by a client.
    match /paymentRequests/{requestId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'planCode', 'amountPaise', 'utr', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.planCode == 'quarterly'
        && request.resource.data.amountPaise == 4900
        && request.resource.data.utr is string
        && request.resource.data.utr.size() >= 6
        && request.resource.data.utr.size() <= 80
        && request.resource.data.status == 'pending';
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Premium entitlements are read-only to clients. Owner/admin changes happen
    // only through a trusted privileged process or the Firebase Console.
    match /memberships/{uid} {
      allow read: if owns(uid);
      allow create, update: if false;
      allow delete: if owns(uid);
    }

    match /activityDays/{documentId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.leaderboardOptIn == true);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.steps is int
        && request.resource.data.steps >= 0
        && request.resource.data.steps <= 200000;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['steps', 'stepGoal', 'workouts', 'leaderboardOptIn', 'displayName', 'updatedAt']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /activityNotifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'kind', 'title', 'body', 'createdAt', 'readAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.kind in ['step_goal', 'workout']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 300
        && request.resource.data.createdAt is string
        && request.resource.data.readAt == null;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // System metadata, admin data, and every unspecified collection stay private.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}